# SkillBridge — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

# ── Flask Core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (XAMPP / MySQL Workbench):
DATABASE_URL=mysql+pymysql://root:@localhost:3306/skillbridge

# Aiven MySQL (production/demo — replace with your Aiven connection string):
# DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@HOST:PORT/skillbridge?ssl_ca=/path/to/ca.pem

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Gmail SMTP (Flask-Mail) ───────────────────────────────────────────────────
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password     # Gmail App Password, NOT your real password

# ── Cloudinary (file/image storage) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── eSewa Sandbox ─────────────────────────────────────────────────────────────
# Official test credentials from eSewa developer docs (sandbox only)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# ── Khalti Sandbox ────────────────────────────────────────────────────────────
# Official test credentials from Khalti developer portal (sandbox only)
KHALTI_SECRET_KEY=test_secret_key_dc74e0fd11ba4b25b72b774c21e2b57f
KHALTI_PUBLIC_KEY=test_public_key_dc74e0fd11ba4b25b72b774c21e2b57f
KHALTI_GATEWAY_URL=https://a.khalti.com/api/v2/epayment/initiate/

# ── App Settings ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
